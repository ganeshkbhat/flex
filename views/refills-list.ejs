<%- include('partials/header') %>

<h1>Claimed Refills List</h1>
<p>Overview of all snack box refill tickets and claims across offices.</p>

<table>
  <thead>
    <tr>
      <th>Refill ID</th>
      <th>Trigger ID</th>
      <th>Refill Date</th>
      <th>Office</th>
      <th>Product</th>
      <th>Assignee / Volunteer</th>
      <th>Ticket Status</th>
      <th>Bill Receipt</th>
      <% if (currentUser && (currentUser.isAdmin === 1 || currentUser.isHr === 1)) { %>
        <th>HR Claim ID</th>
        <th>HR Status (Admin / HR Only)</th>
        <th>Actions</th>
      <% } %>
    </tr>
  </thead>
  <tbody>
    <% if (refills.length === 0) { %>
      <tr><td colspan="<%= (currentUser && (currentUser.isAdmin === 1 || currentUser.isHr === 1)) ? 11 : 8 %>">No claimed refills found.</td></tr>
    <% } %>
    <% refills.forEach(r => { %>
      <tr>
        <td><strong><%= r.id %></strong></td>
        <td><%= r.trigger_id ? `#${r.trigger_id}` : '-' %></td>
        <td><%= r.refill_date %></td>
        <td><%= r.office %></td>
        <td><%= r.product_name || '-' %></td>
        <td><%= r.assignee_name ? `${r.assignee_name} (${r.assignee_id})` : 'Unassigned' %></td>
        <td><span class="badge" style="background: <%= r.status === 'OPEN' ? '#dcfce7' : '#e5e7eb' %>;"><%= r.status %></span></td>
        <td>
          <% if (r.receipt_image && r.receipt_image.startsWith('data:image')) { %>
            <a href="javascript:void(0);" onclick="openImageModal('<%= r.receipt_image %>')" style="color: #2563eb; font-weight: 600; text-decoration: none;">View Image</a>
          <% } else { %>
            <span style="color: #9ca3af;">No image</span>
          <% } %>
        </td>
        <% if (currentUser && (currentUser.isAdmin === 1 || currentUser.isHr === 1)) { %>
          <td><%= r.hr_claim_id || '-' %></td>
          <td>
            <% if (r.hr_claim_id) { %>
              <form action="/api/refills/<%= r.id %>/hr-status" method="POST" style="display:inline;">
                <select name="hrStatus" onchange="this.form.submit()" style="padding: 0.2rem; font-size: 0.8rem;">
                  <option value="PENDING" <%= r.hr_status === 'PENDING' ? 'selected' : '' %>>PENDING</option>
                  <option value="APPROVED" <%= r.hr_status === 'APPROVED' ? 'selected' : '' %>>APPROVED</option>
                  <option value="REIMBURSED" <%= r.hr_status === 'REIMBURSED' ? 'selected' : '' %>>REIMBURSED</option>
                  <option value="REJECTED" <%= r.hr_status === 'REJECTED' ? 'selected' : '' %>>REJECTED</option>
                </select>
              </form>
            <% } else { %>
              -
            <% } %>
          </td>
          <td>
            <a href="/views/refills/<%= r.id %>" style="margin-right: 0.5rem; font-weight: 600; color: #2563eb; text-decoration: none;">View</a>
            <% if (currentUser.isAdmin === 1) { %>
              <button type="button" class="danger" style="padding: 0.15rem 0.4rem; font-size: 0.75rem;" onclick="deleteRefill('<%= r.id %>')">Delete</button>
            <% } %>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </tbody>
</table>

<!-- Image Preview Modal -->
<div id="imageModal" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.7); align-items:center; justify-content:center;">
  <div style="background:white; padding:1rem; border-radius:8px; max-width:90%; max-height:90%; text-align:center; position:relative;">
    <span onclick="closeImageModal()" style="position:absolute; top:5px; right:12px; font-size:24px; cursor:pointer; font-weight:bold;">&times;</span>
    <h3>Receipt Bill Image</h3>
    <img id="modalImageSrc" src="" alt="Receipt Preview" style="max-width:100%; max-height:75vh; margin-top:0.5rem; border:1px solid #ddd;" />
  </div>
</div>

<script>
  function openImageModal(dataUrl) {
    const modal = document.getElementById('imageModal');
    const img = document.getElementById('modalImageSrc');
    img.src = dataUrl;
    modal.style.display = 'flex';
  }

  function closeImageModal() {
    const modal = document.getElementById('imageModal');
    modal.style.display = 'none';
  }

  window.onclick = function(event) {
    const modal = document.getElementById('imageModal');
    if (event.target === modal) {
      modal.style.display = 'none';
    }
  }
</script>

<%- include('partials/footer') %>