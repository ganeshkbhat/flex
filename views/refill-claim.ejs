<%- include('partials/header') %>

<h1>Raise Refill & HR Reimbursement Claim</h1>
<p>File a direct purchase claim for snack box refills with receipt upload[cite: 28].</p>

<% if (message) { %><div class="alert success"><%= message %></div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<form class="card" action="/api/offices/empty" method="POST" id="claimForm" onsubmit="return handleDirectClaimSubmit(event)">
  <div class="row">
    <label>Office / Region
      <select name="office" required>
        <option value="Oslo">Oslo</option>
        <option value="Bengaluru">Bengaluru</option>
      </select>
    </label>
    <label>Refill Date
      <input type="date" name="refillDate" required />
    </label>
    <label>Snack Box Product
      <select name="productId" required>
        <% products.forEach(p => { %>
          <option value="<%= p.id %>"><%= p.name %> (<%= p.unit_price %> <%= p.currency %>)</option>
        <% }) %>
      </select>
    </label>
    <label>Product Quantity
      <input type="number" name="productQuantity" value="1" min="1" required />
    </label>
    <label>Product Unit Price
      <input type="number" name="productPrice" step="0.01" min="0" required />
    </label>
    <label>Assignee / Volunteer ID
      <input type="text" name="assigneeId" value="<%= currentUser.employeeId %>" required />
    </label>
    <label style="grid-column: 1 / -1;">Upload Bill Receipt (Image file)
      <input type="file" id="receiptFileInput" accept="image/*" required />
      <input type="hidden" name="receiptImage" id="receiptImageBase64" />
    </label>
  </div>
  <button type="submit" style="margin-top: 1rem;">Submit HR Reimbursement Claim</button>
</form>

<script>
  function handleDirectClaimSubmit(event) {
    event.preventDefault();
    const fileInput = document.getElementById('receiptFileInput');
    const hiddenInput = document.getElementById('receiptImageBase64');
    const form = document.getElementById('claimForm');

    if (fileInput.files && fileInput.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        hiddenInput.value = e.target.result;
        form.submit();
      };
      reader.readAsDataURL(fileInput.files[0]);
    } else {
      alert('Please upload a valid receipt image.');
    }
  }
</script>

<p><a href="/">&larr; Back to Dashboard</a></p>

<%- include('partials/footer') %>