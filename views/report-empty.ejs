<%- include('partials/header') %>

<h1>Report an Empty Snack Box Trigger</h1>
<p>Any employee can report an empty snack box. Volunteers, HR, and Admins can view these triggers and process box refills.</p>

<% if (message) { %><div class="alert success"><%= message %></div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<!-- Any employee can report an empty box trigger -->
<% if (currentUser && userHasRole(currentUser, 'employee')) { %>
<form class="card" action="/api/offices/empty-trigger" method="POST">
  <h3>Report Empty Box</h3>
  <div class="row">
    <label>Office / Region
      <select name="office" required>
        <option value="Oslo">Oslo</option>
        <option value="Bengaluru">Bengaluru</option>
      </select>
    </label>
    <label>Report Date
      <input type="date" name="refillDate" value="<%= todayDate %>" required />
    </label>
    <label>Snack Box Product
      <select name="productId" required>
        <% products.forEach(p => { %>
          <option value="<%= p.id %>"><%= p.name %> (<%= p.unit_price %> <%= p.currency %>)</option>
        <% }) %>
      </select>
    </label>
  </div>
  <button type="submit" style="margin-top: 1rem;">Submit Trigger</button>
</form>
<% } %>

<h2>Open Empty Box Triggers</h2>
<table>
  <thead>
    <tr>
      <th>Trigger ID</th>
      <th>Region / Office</th>
      <th>Product Box</th>
      <th>Reported By</th>
      <th>Date Raised</th>
      <th>Status</th>
      <% if (currentUser && userHasRole(currentUser, 'volunteer')) { %>
        <th>Action</th>
      <% } %>
    </tr>
  </thead>
  <tbody>
    <% if (triggers.length === 0) { %>
      <tr><td colspan="<%= userHasRole(currentUser, 'volunteer') ? 7 : 6 %>">No open empty box triggers.</td></tr>
    <% } %>
    <% triggers.forEach(t => { %>
      <tr>
        <td><strong>#<%= t.id %></strong></td>
        <td><%= t.office %></td>
        <td><%= t.product_name || '-' %></td>
        <td><%= t.reporter_name %> (<%= t.reporter_id %>)</td>
        <td><%= t.report_date %></td>
        <td><span class="badge" style="background: #fef3c7; color: #b45309;"><%= t.status %></span></td>
        <% if (currentUser && userHasRole(currentUser, 'volunteer')) { %>
          <td>
            <form action="/api/offices/claim-trigger" method="POST" style="display:flex; flex-direction:column; gap:0.4rem; background:#f9fafb; padding:0.5rem; border-radius:4px;" onsubmit="return handleFileConversion(event, this)">
              <input type="hidden" name="triggerId" value="<%= t.id %>" />
              <input type="hidden" name="office" value="<%= t.office %>" />
              <input type="hidden" name="productId" value="<%= t.product_id %>" />
              <input type="hidden" name="assigneeId" value="<%= currentUser.employeeId %>" />
              <input type="hidden" name="receiptImage" id="receipt_hidden_<%= t.id %>" />
              
              <div style="display:flex; gap:0.5rem;">
                <label style="font-size:0.75rem;">Qty: 
                  <input type="number" name="productQuantity" value="1" min="1" required style="width:50px; padding:0.1rem;" />
                </label>
                <label style="font-size:0.75rem;">Price: 
                  <input type="number" name="productPrice" value="500" step="0.01" min="0" required style="width:70px; padding:0.1rem;" />
                </label>
              </div>
              <label style="font-size:0.75rem;">Upload Bill Receipt:
                <input type="file" id="file_input_<%= t.id %>" accept="image/*" required style="width:100%; font-size:0.7rem;" />
              </label>
              <button type="submit" style="padding: 0.2rem 0.5rem; font-size: 0.8rem; background:#2563eb; color:white; border:none; border-radius:3px; cursor:pointer;">Claim & Refill</button>
            </form>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </tbody>
</table>

<script>
  function handleFileConversion(event, form) {
    event.preventDefault();
    const fileInput = form.querySelector('input[type="file"]');
    const hiddenInput = form.querySelector('input[name="receiptImage"]');
    
    if (fileInput && fileInput.files && fileInput.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        hiddenInput.value = e.target.result;
        form.submit();
      };
      reader.onerror = function() {
        alert('Error reading receipt file.');
      };
      reader.readAsDataURL(fileInput.files[0]);
    } else {
      alert('Please select a receipt image file.');
    }
    return false;
  }
</script>

<p><a href="/">&larr; Back to Dashboard</a></p>

<%- include('partials/footer') %>