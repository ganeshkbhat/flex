<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; font-size: 90%; max-width: 1024px; margin: 2rem auto; padding: 0 1rem; color: #1f2937; line-height: 1.5; }
    nav { display: flex; gap: 1rem; padding-bottom: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid #e5e7eb; flex-wrap: wrap; align-items: center; justify-content: space-between; }
    .nav-links { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
    .auth-section { display: flex; gap: 0.75rem; align-items: center; font-size: 0.85rem; font-weight: 600; }
    nav a { text-decoration: none; color: #2563eb; font-weight: 600; }
    nav a:hover { text-decoration: underline; }
    table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
    th, td { border: 1px solid #d1d5db; padding: 0.6rem; text-align: left; vertical-align: middle; }
    th { background: #f3f4f6; }
    form.card { background: #f9fafb; border: 1px solid #e5e7eb; padding: 1rem; border-radius: 6px; margin: 1rem 0; }
    .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; margin-bottom: 0.75rem; }
    label { display: flex; flex-direction: column; font-size: 0.875rem; font-weight: 600; gap: 0.25rem; }
    input, select { padding: 0.45rem; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 0.95rem; }
    button { background: #2563eb; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; font-weight: 600; }
    button.danger { background: #dc2626; }
    button.success { background: #16a34a; }
    .alert { padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
    .alert.success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
    .alert.error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; background: #e5e7eb; }
  </style>
</head>
<body>
  <nav>
    <div class="nav-links">
      <a href="/">Dashboard</a>
      <% if (currentUser && userHasRole(currentUser, 'volunteer')) { %>
        <a href="/views/refills-list">Claimed Refills</a>
        <a href="/views/report-empty">Report Empty Box</a>
      <% } %>
      <% if (currentUser && userHasRole(currentUser, 'admin')) { %>
        <a href="/views/products">Products (CRUD)</a>
        <a href="/views/employees">Employees Management</a>
      <% } %>
      <% if (currentUser && userHasRole(currentUser, 'hr')) { %>
        <a href="/views/reports/monthly">Monthly Report</a>
      <% } %>
      <% if (currentUser) { %>
        <a href="/views/profile">My Profile</a>
      <% } %>
    </div>
    <div class="auth-section">
      <% if (currentUser) { %>
        <span>👤 <%= currentUser.name %></span>
        <a href="/logout" style="color: #dc2626; margin-left: 0.5rem; padding: 0.25rem 0.5rem; border: 1px solid #dc2626; border-radius: 4px; text-decoration: none;">Log Out</a>
      <% } else { %>
        <a href="/login">Log In</a>
        <a href="/register">Register</a>
      <% } %>
    </div>
  </nav>