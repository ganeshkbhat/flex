<%- include('partials/header') %>

<div style="max-width: 450px; margin: 3rem auto;">
  <h1>Employee Registration</h1>
  <p>Create a standard employee account. Volunteer status can be assigned later by an administrator.</p>

  <% if (message) { %><div class="alert success"><%= message %></div><% } %>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>

  <form class="card" action="/api/register" method="POST">
    <label>Employee ID
      <input type="text" name="employeeId" placeholder="EMP-105" required />
    </label>
    <label style="margin-top: 0.5rem;">Full Name
      <input type="text" name="name" placeholder="John Doe" required />
    </label>
    <label style="margin-top: 0.5rem;">Email Address
      <input type="email" name="email" placeholder="john@snack.com" required />
    </label>
    <label style="margin-top: 0.5rem;">Password
      <input type="password" name="password" placeholder="••••••••" required />
    </label>
    <label style="margin-top: 0.5rem;">Home Office
      <select name="homeOffice" required>
        <option value="Oslo">Oslo</option>
        <option value="Bengaluru">Bengaluru</option>
      </select>
    </label>
    <label style="margin-top: 0.5rem;">Active Office
      <select name="activeOffice" required>
        <option value="Oslo">Oslo</option>
        <option value="Bengaluru">Bengaluru</option>
      </select>
    </label>
    <label style="margin-top: 0.5rem;">Payroll Currency
      <select name="payrollCurrency" required>
        <option value="NOK">NOK</option>
        <option value="INR">INR</option>
      </select>
    </label>
    <button type="submit" style="margin-top: 1rem; width: 100%;">Register Account</button>
  </form>
  
  <p style="text-align: center; margin-top: 1rem; font-size: 0.85rem;">
    Already have an account? <a href="/login">Log in here</a>
  </p>
</div>

<%- include('partials/footer') %>