<%- include('partials/header') %>

<div style="max-width: 400px; margin: 4rem auto;">
  <h1>Sign In</h1>
  <p>Log in with your employee email and password.</p>

  <% if (message) { %><div class="alert success"><%= message %></div><% } %>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>

  <form class="card" action="/api/login" method="POST">
    <label>Email Address
      <input type="email" name="email" placeholder="admin@snack.com" required />
    </label>
    <label style="margin-top: 0.75rem;">Password
      <input type="password" name="password" placeholder="••••••••" required />
    </label>
    <button type="submit" style="margin-top: 1rem; width: 100%;">Log In</button>
  </form>

  <p style="text-align: center; margin-top: 1rem; font-size: 0.85rem;">
    Don't have an account? <a href="/register">Register here</a>
  </p>

  <div style="margin-top: 1.5rem; font-size: 0.82rem; color: #64748b; background: #f8fafc; padding: 0.75rem; border-radius: 4px;">
    <strong>Default Demo Credentials:</strong><br>
    • Admin: <code>admin@snack.com</code> / <code>admin123</code><br>
    • HR Officer: <code>hr@snack.com</code> / <code>hr123</code><br>
    • Volunteer: <code>volunteer@snack.com</code> / <code>vol123</code>
  </div>
</div>

<%- include('partials/footer') %>