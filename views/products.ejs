<%- include('partials/header') %>

<h1>Product List Management (CRUD)</h1>
<p>Manage office snack products. One product is marked as <strong>Default</strong> for auto-selection.</p>

<% if (message) { %><div class="alert success"><%= message %></div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<form class="card" action="/api/products" method="POST">
  <h3>Add New Product</h3>
  <div class="row">
    <label>Product Name
      <input type="text" name="name" placeholder="Assorted Snack Box" required />
    </label>
    <label>Office Scope
      <select name="office" required>
        <option value="GLOBAL">GLOBAL</option>
        <option value="Oslo">Oslo</option>
        <option value="Bengaluru">Bengaluru</option>
      </select>
    </label>
    <label>Unit Price
      <input type="number" step="0.01" name="unitPrice" placeholder="600" required />
    </label>
    <label>Currency
      <select name="currency" required>
        <option value="NOK">NOK</option>
        <option value="INR">INR</option>
      </select>
    </label>
  </div>
  <div class="row">
    <label style="flex-direction: row; align-items: center;">
      <input type="checkbox" name="isDefault" /> Make this the Default Product
    </label>
  </div>
  <button type="submit">Add Product</button>
</form>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Product Name</th>
      <th>Office</th>
      <th>Unit Price</th>
      <th>Currency</th>
      <th>Default?</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td><%= p.id %></td>
        <td><input type="text" id="name-<%= p.id %>" value="<%= p.name %>" /></td>
        <td>
          <select id="office-<%= p.id %>">
            <option value="GLOBAL" <%= p.office === 'GLOBAL' ? 'selected' : '' %>>GLOBAL</option>
            <option value="Oslo" <%= p.office === 'Oslo' ? 'selected' : '' %>>Oslo</option>
            <option value="Bengaluru" <%= p.office === 'Bengaluru' ? 'selected' : '' %>>Bengaluru</option>
          </select>
        </td>
        <td><input type="number" step="0.01" id="price-<%= p.id %>" value="<%= p.unit_price %>" /></td>
        <td>
          <select id="curr-<%= p.id %>">
            <option value="NOK" <%= p.currency === 'NOK' ? 'selected' : '' %>>NOK</option>
            <option value="INR" <%= p.currency === 'INR' ? 'selected' : '' %>>INR</option>
          </select>
        </td>
        <td>
          <% if (p.is_default) { %>
            <span class="badge" style="background:#dcfce7; color:#166534;">DEFAULT</span>
          <% } else { %>
            <form action="/api/products/<%= p.id %>/set-default" method="POST" style="display:inline;">
              <button type="submit" style="padding:0.2rem 0.5rem; font-size:0.75rem;">Set Default</button>
            </form>
          <% } %>
        </td>
        <td>
          <button type="button" onclick="updateProduct(<%= p.id %>, <%= p.is_default %>)">Update</button>
          <% if (!p.is_default) { %>
            <button type="button" class="danger" onclick="deleteProduct(<%= p.id %>)">Delete</button>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<script>
  async function updateProduct(id, isDefault) {
    const res = await fetch('/api/products/' + id, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        name: document.getElementById('name-' + id).value,
        office: document.getElementById('office-' + id).value,
        unitPrice: Number(document.getElementById('price-' + id).value),
        currency: document.getElementById('curr-' + id).value,
        isDefault: Boolean(isDefault)
      })
    });
    if (res.ok) window.location = '/views/products?message=Product+updated';
    else alert((await res.json()).error);
  }

  async function deleteProduct(id) {
    if (!confirm('Delete this product?')) return;
    const res = await fetch('/api/products/' + id, {
      method: 'DELETE',
      headers: { 'Accept': 'application/json' }
    });
    if (res.ok) window.location = '/views/products?message=Product+deleted';
    else alert((await res.json()).error);
  }
</script>

<%- include('partials/footer') %>